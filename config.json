{
  "server": {
    "base_url": "http://127.0.0.1:8000/v1",
    "api_key_env": "ZIVON_API_KEY",
    "model": "CHANGE-ME",
    "json_mode": true,
    "temperature": 0.2,
    "max_tokens": 4096,
    "timeout_s": 600,
    "max_attempts": 3
  },
  "learner": {
    "class_level": 9,
    "language": "en"
  },
  "retrieval": {
    "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
    "device": "cpu",
    "top_k": 6,
    "chunk_chars": 1200,
    "chunk_overlap": 120
  },
  "limits": {
    "max_chars_ncert_to_model": 60000,
    "max_chars_supplement_each": 4000,
    "max_chars_supplement_total": 16000
  },
  "paths": {
    "catalog": "sources/catalog.json",
    "pdf_cache": "sources/pdfs",
    "text_cache": "sources/cache",
    "runs": "runs",
    "frontend": "frontend",
    "doctrine": "docs/frontend/design-doctrine.md",
    "doctrine_example": "docs/frontend/design-doctrine-example.html"
  },
  "perf": {
    "profile": "testing/perf/profiles/weak-android.json",
    "fix_rounds": 3
  },
  "stage_overrides": {}
}
