{
  "learner": {
    "language": "en"
  },
  "retrieval": {
    "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
    "device": "cpu",
    "top_k": 6,
    "chunk_chars": 1200,
    "chunk_overlap": 120
  },
  "limits": {
    "max_chars_ncert_to_model": 120000,
    "max_chars_supplement_each": 4000,
    "max_chars_supplement_total": 16000,
    "max_chars_design_context": 80000
  },
  "paths": {
    "catalog": "sources/catalog.json",
    "pdf_cache": "sources/pdfs",
    "text_cache": "sources/cache",
    "runs": "runs",
    "frontend": "frontend",
    "doctrine": "docs/frontend/design-doctrine.md",
    "doctrine_examples": "docs/frontend/design-doctrine-lesson*.html"
  },
  "perf": {
    "profile": "testing/content_factory/perf/profiles/weak-android.json",
    "fix_rounds": 6
  },
  "repair": {
    "content_rounds": 8,
    "code_rounds": 6,
    "translation_rounds": 6,
    "stall_rounds": 3
  },
  "translation": {
    "enabled": false,
    "target_locales": [
      "hi",
      "hi-Latn"
    ],
    "optional_locales": [],
    "glossary_path": "sources/glossary/physics_glossary.json",
    "ui_strings_path": "sources/glossary/ui_strings.json",
    "prompt_version": "1",
    "max_chars_neighbour_context": 600
  },
  "assessment": {
    "syllabus_path": "sources/syllabus/syllabus.json",
    "chapters_dir": "sources/syllabus/chapters",
    "export_dir": "",
    "generator": "seed",
    "languages": [
      "en",
      "hi",
      "hi-Latn"
    ],
    "min_items_per_chapter": 15,
    "max_items_per_chapter": 20,
    "max_items_per_concept": 6,
    "speaking_prompts_min": 3,
    "item_repair_rounds": 2,
    "time_prior_min_ms": 15000,
    "time_prior_max_ms": 300000
  },
  "stage_overrides": {}
}
