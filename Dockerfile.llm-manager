# syntax=docker/dockerfile:1
# Zivon llm-manager node image: the shared model-call module (llm_manager/)
# behind a small OpenAI-format HTTP service. This is an ISOLATED node: the
# factory Job, the test suite and every future consumer (translator) talk to
# THIS service, and THIS service is the only caller of the inference server
# (via the dev inference router in container/cluster setups).
#
#   Build:  docker build -f Dockerfile.llm-manager -t zivon-llm-manager:0.1.0 .
#   Run:    docker run --rm -p 8000:8000 \
#             -e ZIVON_BASE_URL=http://192.168.49.1:18080/v1 \
#             -e ZIVON_MODEL=<model> zivon-llm-manager:0.1.0
#   Probe:  curl -s http://127.0.0.1:8000/healthz
#
# Deliberately NOT the factory image: no torch, no pdfplumber, no playwright
# (see llm_manager/requirements.txt) - small, fast to start, and an
# independent CVE surface for the trivy gate.
#
# logging_manager ships in this image too (EX3-OBS): the node emits node.*
# events through it (llm_manager/service/app.py imports it lazily); without
# the package the node silently emits nothing. The instrumentation map's
# single copy ships at the path events.default_map_path() resolves
# (docs/specs/observability/ — the source of truth, baked into the image so
# severity/component lookups work; not duplicated inside the package).

FROM python:3.12-slim

# Python writes logs immediately (critical inside containers) and skips .pyc files.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

# Freshen the Debian layer under the floating python:3.12-slim base. The base
# ships a frozen apt index from its build date, so fixes published afterwards
# are invisible until apt-get update runs: the newest 3.12-slim build (2026-11-08)
# still carries zlib1g 1:1.3.dfsg+really1.3.1-1+b1, which trivy flags HIGH with
# fixes out (CVE-2026-85091 heap overflow in gz_vacate, CVE-2026-76844).
# Whole-tree upgrade, unpinned, on purpose: Debian drops old point revisions
# from the archive, so pins rot; the frozen-index problem hits whatever package
# the next CVE lands on, not just zlib.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies BEFORE copying code (layer cache: code edits do not
# re-download the wheels).
COPY llm_manager/requirements.txt ./llm_manager/requirements.txt
COPY logging_manager/requirements.txt ./logging_manager/requirements.txt
RUN pip install --no-cache-dir -r llm_manager/requirements.txt \
    -r logging_manager/requirements.txt

# Copy ONLY the standalone package + the logging contract it emits through -
# the image has no factory code at all.
COPY llm_manager ./llm_manager
COPY logging_manager ./logging_manager
COPY docs/specs/observability/instrumentation-map.csv \
    ./docs/specs/observability/instrumentation-map.csv

# Never run as root: fixed UID + numeric USER (kubelet-verifiable, hadolint
# DL3066 - the same convention as the factory image).
RUN useradd --create-home --uid 1000 app
USER 1000

EXPOSE 8000

# The entry point loads ZIVON_BASE_URL / ZIVON_MODEL loudly and refuses to
# boot without them (a misconfigured node must die at boot, not per-request).
CMD ["python", "-m", "llm_manager.service"]
