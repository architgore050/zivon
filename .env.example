# Content factory runtime configuration - copy to a shell env or your
# container/cluster secret store. NEVER commit real values (AGENTS.md:
# configuration lives in environment variables; secrets never enter files).
# Full reference: docs/content-factory/config-reference.md
#
# Call topology (2026-11-07): every consumer talks OpenAI chat-completions to
# the llm-manager NODE (own image, k8s/16-llm-manager.yaml), and that node is
# the only caller of the inference server:
#   factory -> llm-manager node -> (inference router) -> inference server
# Locally WITHOUT containers you may point ZIVON_BASE_URL straight at the
# server and skip the node entirely - the library in llm_manager/ is what the
# factory runs in-process either way.

# Required - which OpenAI-format base the factory talks to.
#   In the cluster: the llm-manager Service (see k8s/infra.env:
#   ZIVON_LLM_MANAGER_URL -> the factory ConfigMap's ZIVON_BASE_URL).
#   Local dev, direct (no node):     http://127.0.0.1:8080/v1
#   Local dev, through the node:     http://127.0.0.1:18090/v1
#     (run the node: docker compose up -d llm-manager)
#   Containers/cluster via the router: http://192.168.49.1:18080/v1 (the
#     NODE's upstream, set in k8s/infra.env - not the factory's).
ZIVON_BASE_URL=http://192.168.49.1:18080/v1
ZIVON_MODEL=qwen3.8-flash-next-iq3_xxs   # as reported by GET /v1/models

# Optional - only if your server needs auth (the llm-manager node reads the
# same variable for its own upstream leg):
# ZIVON_API_KEY=

# Optional - sampling / streaming knobs (code defaults shown). The factory
# sends NO completion cap (no max_tokens at all - 2026-11-04 founder decision:
# the server decides answer length, thinking included, within its own context;
# max_tokens exists only as a constructor argument for future consumers) and
# puts NO wall-clock cap on a run (2026-11-06 founder decision - the caps
# below are per model CALL, state-aware, not run timers):
# ZIVON_JSON_MODE=true
# ZIVON_TEMPERATURE=0.2
#
# STREAMING SEMANTICS (2026-11-07 - changed, loud): model calls stream by
# default, so ZIVON_TIMEOUT_S is the max INACTIVITY between streamed chunks -
# a generating server keeps the call alive, a dead one is detected honestly.
# (With ZIVON_STREAM=false it degrades to the old per-read-operation timeout,
# which bounds nothing: a non-streaming response sends zero bytes until the
# end. That gap is why streaming is the default.)
# ZIVON_STREAM=true
# ZIVON_STREAM_USAGE=true    # usage stats in the final stream chunk; set
#                            # false if your server rejects stream_options
# ZIVON_TIMEOUT_S=3600       # max inactivity between chunks (see above)
# ZIVON_CALL_DEADLINE_S=0    # total wall-clock cap per model call; the
#                            # cluster ships 7200 (see k8s/infra.env). On
#                            # breach the stream is closed mid-generation so
#                            # the server stops generating. 0 = no cap.
# ZIVON_CONNECT_TIMEOUT_S=10
# ZIVON_MAX_ATTEMPTS=3       # transport retries only (connection errors,
#                            # timeouts, 429, 5xx)
# ZIVON_BACKOFF_BASE_S=2.0   # exponential backoff base (2 -> 4 -> 8 ...)
# ZIVON_VALIDATION_ROUNDS=5  # the model's own repair budget per stage call -
#                            # separate from the transport budget above
# ZIVON_HEARTBEAT_S=60       # progress-print cadence ("N chunks received")

# --- NARRATION (stage 12-narration - build-time read-aloud, C-051) ---------
# Opt-in: a bounded credit spend (backend-spec A-15, default tranche 1500
# credits [ASSUMPTION]). Off = clean no-op. Full table:
# docs/content-factory/config-reference.md ("Narration & Timbre").
# ZIVON_NARRATION_ENABLED=false
# ZIVON_NARRATION_MODE=auto            # auto = live iff a Timbre endpoint is set
# ZIVON_NARRATION_LANGS=en             # ADR-0009 locale enum
# ZIVON_NARRATION_BUDGET_CREDITS=1500
# ZIVON_NARRATION_REPAIR_ROUNDS=2
# ZIVON_TIMBRE_BASE_URL=               # Gnani Timbre v3.0 endpoint (live mode)
# ZIVON_TIMBRE_API_KEY=                # runtime secret - never commit
# ZIVON_TIMBRE_CREDITS_PER_CHAR=0.0167 # capacity-model default until A-01 prices
# ZIVON_COLDSTORE_UPLOAD_CMD=          # e.g. rclone copyto {src} b2:bucket/{dst}
# ZIVON_COLDSTORE_READBACK_CMD=        # e.g. rclone cat b2:bucket/{dst}

# --- DEV / LOCAL COMPOSE ONLY (docker-compose.yml `dev-stack` + `backend`
# --- profiles, and the dashboard service) ---------------------------------
# Throwaway local values. In the cluster the same settings come from
# `k8s/infra.env` (config) and the Secrets in docs/deployment/secrets.md —
# never from this file. Unset values keep the documented dev posture.
# DEV_DB_USER=zivon
# DEV_DB_PASSWORD=zivon                # throwaway local Postgres only
# DEV_DB_NAME=zivon
# ZIVON_ENV=dev
# ZIVON_LOG_LEVEL=INFO
# ZIVON_LOG_DSN=                       # unset = dashboard uses the JSONL fallback
# ZIVON_ADMIN_TOKEN=                   # unset = admin routes answer 503 (dev posture)
# ZIVON_VOICE_BRAIN_TRANSPORT=gemini-direct
# ZIVON_VOICE_BRAIN_MODEL=gemma-4-26b-a4b-it
# ZIVON_VOICE_STT_URL=                 # empty = mock/degraded dev transport
# ZIVON_VOICE_TTS_URL=                 # empty = mock/degraded dev transport
