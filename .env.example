# Content factory runtime configuration - copy to a shell env or your
# container/cluster secret store. NEVER commit real values (AGENTS.md:
# configuration lives in environment variables; secrets never enter files).
# Full reference: docs/content-factory/config-reference.md

# Required - which inference server the factory talks to.
# Dev default: the inference router (docker compose up -d inference-router),
# which forwards 192.168.49.1:18080 -> the host's loopback server on :8080.
ZIVON_BASE_URL=http://192.168.49.1:18080/v1
ZIVON_MODEL=qwen3.8-flash-next-iq3_xxs   # as reported by GET /v1/models

# Optional - only if your server needs auth:
# ZIVON_API_KEY=

# Optional - sampling / retry knobs (code defaults shown). The factory sends
# NO completion cap (no max_tokens at all - 2026-11-04 founder decision: the
# server decides answer length, thinking included, within its own context);
# the read timeout + Job deadline are the backstops:
# ZIVON_JSON_MODE=true
# ZIVON_TEMPERATURE=0.2
# ZIVON_TIMEOUT_S=3600
# ZIVON_MAX_ATTEMPTS=3
