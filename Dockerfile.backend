# syntax=docker/dockerfile:1
# Zivon core backend monolith image (ADR-0005, ADR-0020):
# FastAPI modular monolith (`backend/`, `db/`, `guard/`, `alembic/`) with the
# voice loop mounted in-process (`voice/`, EX1-VOICE — one image, no separate
# voice deployment per ADR-0020).
#
#   Build:  docker build -f Dockerfile.backend -t zivon-backend:0.1.0 .
#   Smoke:  docker run --rm zivon-backend:0.1.0 python -m backend --smoke
#   Run:    docker run --rm -p 8000:8000 \
#             -e ZIVON_ENV=dev -e ZIVON_DB_URL=sqlite:///:memory: \
#             zivon-backend:0.1.0
#           (ZIVON_ENV is required: the server refuses to boot on silent
#           defaults — see backend/__main__.py)

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

# Freshen OS packages against frozen-index CVEs (same hardening pattern as
# Dockerfile and Dockerfile.llm-manager; see docs/deployment/docker.md).
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies BEFORE copying application code for layer caching. The
# voice loop owns its own small requirements file (google-genai, websockets) so
# backend/ stays the slim FastAPI+DB set; both install in one layer.
COPY backend/requirements.txt ./backend/requirements.txt
COPY voice/requirements.txt ./voice/requirements.txt
RUN pip install --no-cache-dir \
        -r backend/requirements.txt \
        -r voice/requirements.txt

# Copy the backend monolith packages, the mounted voice package, and the
# Alembic migration assets (alembic.ini's version_locations spans both
# alembic/versions and migrations/versions).
COPY alembic.ini ./alembic.ini
COPY alembic ./alembic
COPY migrations ./migrations
COPY db ./db
COPY guard ./guard
COPY backend ./backend
COPY voice ./voice
COPY scripts/trigger-tests.sh ./scripts/trigger-tests.sh
COPY scripts/trigger-factory-run.sh ./scripts/trigger-factory-run.sh
COPY scripts/logs-factory-run.sh ./scripts/logs-factory-run.sh
COPY scripts/publish-verify-hook.sh ./scripts/publish-verify-hook.sh

# Non-root execution with numeric UID 1000 (kube-linter + hadolint DL3066).
RUN useradd --create-home --uid 1000 app
USER 1000

EXPOSE 8000

CMD ["python", "-m", "backend"]
