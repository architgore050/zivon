# ============================================================================
# Cluster infra config — THE single source of truth for cluster config values.
# Consumed by scripts/apply-k8s.sh, which renders these into the manifests and
# TWO ConfigMaps:
#   zivon-llm-manager-config — the llm-manager NODE's own env: its upstream is
#                              ZIVON_BASE_URL below (the inference router).
#   zivon-factory-config     — the FACTORY's env: its ZIVON_BASE_URL is the
#                              llm-manager Service (ZIVON_LLM_MANAGER_URL).
#     factory Job -> llm-manager Service -> inference-router -> host server
# Change a value here, re-run the script.
#
# Secrets NEVER belong in this file (AGENTS.md): API keys exist only as the
# runtime K8s Secret zivon-factory-env (read by BOTH the llm-manager node and
# the factory Job).
#
# Image tags are deliberately NOT here: they are code versions, pinned in the
# manifests and bumped together with the code they contain (gotcha 9).
# ============================================================================

# How often the full test suite runs in-cluster. Cron syntax, minute
# granularity: min hour day month weekday. The value below = every 30 minutes.
# Other examples: every 5 min, hourly, daily at 21:30.
TEST_CRON_SCHEDULE="*/30 * * * *"

# Free-route model (founder decision 2026-11-10): the stealth free model
# (stealth/crouton-alpha) revealed itself and is no longer free — the same
# day it was also removed from OpenRouter's catalog entirely.
# FIRST switch (same day): nvidia/nemotron-3-ultra-550b-a55b:free — probed
# live (exact free-route slug, 1M ctx, pricing 0, JSON mode honored, real
# usage stats), but its first real run died at 02-generate on a steps-shape
# contract violation (fixed in 0.3.19: rule_shapes; it also burned attempts
# on schema misses — the "famously kind of stupid" risk made good).
# CURRENT (founder decision, 2026-11-10 later the same day): BETTER INFERENCE —
# the founder's OpenCode Go subscription as an OpenAI-compatible endpoint
# (https://opencode.ai/inference/go/openai/v1, model deepseek-v4.1-flash).
# Usage counts against the Go monthly/5-hour/weekly limits exactly like the
# TUI. The key is the Go API key in Secret zivon-factory-env (ZIVON_API_KEY) —
# update it with:
#   kubectl create secret generic zivon-factory-env -n zivon \
#     --from-literal=ZIVON_API_KEY='<opencode-go-key>' \
#     --dry-run=client -o yaml | kubectl apply -f -
# then re-run scripts/apply-k8s.sh (rollout-restarts the node). Probe first:
# the Go gateway may treat response_format/stream_options differently than
# OpenRouter — if JSON mode 400s, flip ZIVON_JSON_MODE=false per the note.
# Fallback ladder if a route dies: nemotron (OpenRouter, free) → the founder's
# locally served slow qwen3.8-flash-next-iq3_xxs via the router
# (http://192.168.49.1:18080/v1 + ZIVON_MODEL=qwen3.8-flash-next-iq3_xxs).
ZIVON_BASE_URL="https://opencode.ai/inference/go/openai/v1"
ZIVON_MODEL="deepseek-v4.1-flash"

# The llm-manager node's address AS SEEN FROM the factory (cluster-internal
# ClusterIP Service, k8s/16-llm-manager.yaml). Rendered into the
# zivon-factory-config ConfigMap as the factory's ZIVON_BASE_URL: the factory
# speaks plain OpenAI chat-completions to the node and never touches the
# router or the server itself.
ZIVON_LLM_MANAGER_URL="http://llm-manager.zivon.svc.cluster.local:80/v1"

# Model-call timeout semantics (2026-11-07, streaming): model calls are
# STREAMING, so ZIVON_TIMEOUT_S is the maximum INACTIVITY between streamed
# chunks — a server generating tokens keeps the call alive, a dead server is
# detected honestly after this many silent seconds. (When ZIVON_STREAM=false
# it degrades to the classic per-read-operation timeout, which bounds
# nothing.) CLOUD-ERA VALUES (2026-11-09): the old 3600 was tuned for the
# local server (single-slot, ~20-30 tok/s, tens of thousands of thinking
# tokens before real output). Now the node talks to OpenRouter: first tokens
# arrive in 5-37 s, so 600 s of stream silence means the call is stalled —
# detected in minutes, then retried by the node (ZIVON_MAX_ATTEMPTS), instead
# of sitting silent for ~47 min (run 110435: 1 chunk, then nothing, until the
# minikube node rebooted and killed the Job). If a model legitimately needs
# longer silent thinking, raise this deliberately, with evidence.
# Standing decisions that still hold: the factory sends NO completion cap at
# all (max_tokens removed 2026-11-04 — thinking models spend tokens before
# output, and a cap becomes a truncation point), and there is NO wall-clock
# cap on the run Job (2026-11-06: a blind timer must not kill a run that is
# healthy and progressing) — the state-aware backstops are this inactivity
# timeout and ZIVON_CALL_DEADLINE_S below.
ZIVON_TIMEOUT_S="600"

# Per-call wall-clock backstop (seconds): when a single call exceeds this —
# even while streaming normally — the node closes the stream mid-generation,
# which makes the server stop generating and frees its single slot. This is
# the fix for the 2026-11-07 runaway (77,921 -> 131,445 -> 199,056 tokens per
# attempt while the client sat silent): the inactivity timeout is now honest,
# and this deadline bounds even a HEALTHY but endless generation. CLOUD-ERA
# (2026-11-09): 1800 s — a healthy cloud call never needs more (observed
# 25-62 s/call); a pathological think is cut at 30 min instead of 2 h.
# "0" would disable the cap — do not ship that.
ZIVON_CALL_DEADLINE_S="1800"

# Streaming is the default transport (bytes flow = honest timeouts + live
# progress). ZIVON_STREAM_USAGE asks for usage stats in the final stream
# chunk (stream_options.include_usage). PROBE FIRST before flipping either:
# the probe command lives in docs/content-factory/runbook.md. If the server
# rejects stream_options with a 400 (the error names it and says exactly
# this), set ZIVON_STREAM_USAGE="false" — never disable ZIVON_STREAM itself.
ZIVON_STREAM="true"
ZIVON_STREAM_USAGE="true"

# JSON mode is a NODE-side policy (the node ignores response_format in request
# bodies; its own env decides whether the upstream call asks for JSON mode).
# Rendered into zivon-llm-manager-config only. If the server 400s blaming
# response_format json_object (the error says "set ZIVON_JSON_MODE=false"),
# flip THIS value and re-apply - not the factory side.
ZIVON_JSON_MODE="true"

# Transport-retry budget for the model call's UPSTREAM leg (connection
# errors, timeouts, 429, 5xx) — owned by the llm-manager node.
ZIVON_MAX_ATTEMPTS="3"

# Extra headers + client identity for the upstream (2026-11-10): the OpenCode
# Go gateway requires a stable x-opencode-session per conversation (routing +
# prompt-cache affinity) and asks clients to identify themselves instead of
# spoofing an SDK user agent. Rendered into zivon-llm-manager-config only.
# A static session id means every run shares one routing bucket — acceptable:
# the header's purpose is affinity, not isolation.
ZIVON_EXTRA_HEADERS='{"x-opencode-session":"zivon-factory-pipeline"}'
ZIVON_USER_AGENT="zivon-factory/0.3.22"

# Reasoning/thinking effort (founder decision 2026-11-10: "put reasoning effort
# on the highest available setting for the pipeline runs"). DeepSeek V4.1 Flash
# on the Go gateway accepts low/medium/high and reports reasoning_tokens in
# usage; "high" is the highest. Unset = server default. Node-side only.
# MEASURED context: 02-generate on this model thought ~56k completion tokens
# for a 31k-token prompt (~487 s at ~115 tok/s) - thinking, not slowness. High
# effort makes calls longer, never faster; the wall-clock backstop below is
# what bounds a pathological think.
ZIVON_REASONING_EFFORT="high"

# The FACTORY leg does NOT retry transport (its ZIVON_BASE_URL is the
# llm-manager node, which already retried the upstream leg with the budget
# above). Without this split, one dead upstream would fan out into
# node-attempts x factory-attempts calls. The factory's own retry budget
# stays "3" in every non-cluster setup where it talks to the server directly.
ZIVON_FACTORY_MAX_ATTEMPTS="1"
