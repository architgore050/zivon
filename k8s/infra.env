# ============================================================================
# Cluster infra config — THE single source of truth for cluster config values.
# Consumed by scripts/apply-k8s.sh, which renders these into the manifests and
# the zivon-factory-config ConfigMap. Change a value here, re-run the script.
#
# Secrets NEVER belong in this file (AGENTS.md): API keys exist only as the
# runtime K8s Secret zivon-factory-env.
#
# Image tags are deliberately NOT here: they are code versions, pinned in the
# manifests and bumped together with the code they contain (gotcha 9).
# ============================================================================

# How often the full test suite runs in-cluster. Cron syntax, minute
# granularity: min hour day month weekday. The value below = every 30 minutes.
# Other examples: every 5 min, hourly, daily at 21:30.
TEST_CRON_SCHEDULE="*/30 * * * *"

# Which inference server factory runs talk to (rendered into the
# zivon-factory-config ConfigMap; the run Job reads it via envFrom).
# Dev default: the inference router (docker compose up -d inference-router)
# forwarding 192.168.49.1:18080 -> the host's loopback-only server on :8080.
ZIVON_BASE_URL="http://192.168.49.1:18080/v1"
ZIVON_MODEL="qwen3.8-flash-next-iq3_xxs"

# Per-request read timeout + completion cap for model calls. Deliberately
# huge, to the point of being non-binding: the dev server is single-slot at
# worst-case ~20 tok/s and qwen spends 5-10k tokens THINKING before real
# output, so any tight cap becomes the failure point (tight budgets caused
# structured-output truncation, then cascading read timeouts). The server
# clamps max_tokens to its remaining context (256k here), and the run Job's
# activeDeadlineSeconds (2 h) is the real backstop. The server queues
# requests one at a time: do not fire ad-hoc curl probes at it while a
# factory run is live. Revisit when a faster/multi-slot server arrives.
ZIVON_MAX_TOKENS="65536"
ZIVON_TIMEOUT_S="3600"
