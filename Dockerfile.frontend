# syntax=docker/dockerfile:1
# Zivon frontend image: the static site, served by nginx.
#   Build:  docker build -f Dockerfile.frontend -t zivon-frontend:0.1.6 .
#   Run:    docker run --rm -p 8081:8080 -v "$PWD/frontend:/usr/share/nginx/html" \
#               zivon-frontend:0.1.6        # then open http://localhost:8081
#
# What is baked: the HAND-MAINTAINED shell only - index.html, the public-site
# folders (catalogue, class pages, method/about/pricing/trust pages, privacy),
# 404.html, assets/ (shared CSS/JS, local fonts) and the nginx site config.
# Generated pipeline output (courses/, courses.js) is NEVER baked into an image
# (repo rule): it arrives at runtime on a volume (compose) or PVC (cluster)
# mounted at the html root.
#
# nginx-unprivileged is the official non-root nginx variant: runs as UID 101,
# listens on 8080, keeps the stock nginx.conf (our file replaces only the
# default site). Base pinned to a micro tag on the newest Alpine (trivy gate:
# 1.27-alpine's Alpine packages carried 3 CRITICAL + 58 HIGH with fixes out).

FROM nginxinc/nginx-unprivileged:1.31.7-alpine3.24

# Freshen the Alpine packages whose fixes landed after this base was built
# (trivy gate: HIGH+CRITICAL findings with fixes out). Round 1: brotli/curl/
# libcurl/libexpat. Round 2 (2026-11-09): musl + musl-utils (CVE-2026-107891,
# regcomp integer overflow -> 1.2.6-r3) and zlib (CVE-2026-85091, gz_vacate
# heap overflow -> 1.3.2-r1) — 1.31.7-alpine3.24 is still the newest micro
# build of this base (last rebuilt 2026-10-19; tag re-checked on Docker Hub
# 2026-11-17), so bumping the tag cannot reach those fixes; this layer is the
# fix. Round 3 (2026-11-16, P5 CI; mechanism pinned 2026-11-17, W4 ci-hygiene):
# libxslt (CVE-2026-125350 / -87636 / -9947) — the base ships libxslt
# 1.1.43-r3 (read from the image's apk DB; it enters as a soname dependency
# of the baked nginx-module-xslt), the fix is 1.1.43-r4, and the Alpine v3.24
# main repo carries exactly that build (APKINDEX checked 2026-11-17; its deps
# are sonames already satisfied by the base), so libxslt is upgraded to that
# EXACT PIN below.
# Round 4 (2026-11-21, CI unblock): libxml2 (CVE-2026-86144, information
# disclosure/SSRF/DoS; base ships 2.13.9-r2, Alpine v3.24 carries 2.13.9-r3).
# The apk update is required: the base ships a frozen index from its build date,
# so the newer fixes are invisible to apk without it. The freshening upgrades
# are targeted + unpinned on purpose: Alpine repos keep only the newest -r
# revision, so exact pins rot within days; nginx itself is deliberately NOT
# upgraded. libxslt is the one deliberate exception — its exact pin encodes
# the Trivy-verified fix build the scan gate reads, and when Alpine supersedes
# 1.1.43-r4 in v3.24 the pin fails the build loudly instead of silently
# drifting: bump it to the new -r revision in the same PR (the same
# bump-deliberately ritual as the CI tool pins). The USER sandwich is
# required: the unprivileged base runs as UID 101 and apk needs root; the
# final USER stays non-root.
# hadolint ignore=DL3018
USER 0
RUN apk update && apk add --no-cache libxslt=1.1.43-r4 && apk upgrade --no-cache brotli-libs curl libcurl libexpat libxml2 musl musl-utils zlib
USER 101

# Replace the stock default site with the Zivon site config.
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# The shell lives in a staging path so the served root can be a volume/PVC
# without losing it: compose mounts ./frontend directly; the K8s Deployment
# seeds it into an empty PVC with a no-clobber initContainer (cp -rn).
COPY frontend/index.html /opt/zivon-shell/index.html
COPY frontend/404.html /opt/zivon-shell/404.html
COPY frontend/catalogue /opt/zivon-shell/catalogue
COPY frontend/class-9-physics /opt/zivon-shell/class-9-physics
COPY frontend/class-10-physics /opt/zivon-shell/class-10-physics
COPY frontend/class-11-physics /opt/zivon-shell/class-11-physics
COPY frontend/class-12-physics /opt/zivon-shell/class-12-physics
COPY frontend/method /opt/zivon-shell/method
COPY frontend/about /opt/zivon-shell/about
COPY frontend/pricing /opt/zivon-shell/pricing
COPY frontend/terms /opt/zivon-shell/terms
COPY frontend/contact /opt/zivon-shell/contact
COPY frontend/status /opt/zivon-shell/status
COPY frontend/privacy /opt/zivon-shell/privacy
COPY frontend/assets /opt/zivon-shell/assets

EXPOSE 8080
