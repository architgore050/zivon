# --- secrets ---
.env
.env.*
!.env.example
*.pem
# exception: public pinned CA chains (e.g. ncert.nic.in) are not secrets and must ship
!sources/certs/*.pem
*.key

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- node / frontend ---
node_modules/
dist/
build/
.next/
.cache/

# --- logs / data / local artifacts ---
# anchored to the repo root so docs/logs/ (session logs) stays trackable
/logs/
*.log
*.sqlite
*.db
data/local/
coverage/

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- demo/recording scratch ---
recordings/
*.mp4
*.wav
*.mp3

# --- content factory local artifacts (never commit) ---
runs/
sources/pdfs/
sources/cache/

# --- local tool binaries (installed via curl; real copies live in /usr/local/bin) ---
kubectl
minikube-linux-amd64
