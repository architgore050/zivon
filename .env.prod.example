# ============================================================================
# Zivon PROTOTYPE/PRODUCTION environment template — docker-compose.prod.yml
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod        # secrets live here; owner-read only
#   $EDITOR .env.prod          # fill EVERY "REQUIRED" value below
#
# Plain-language walk-through of every value (where each comes from):
#   docs/deployment/founder-cutover-runbook.md §c
#
# PLACEHOLDERS ONLY in this file — never real values, and .env.prod itself is
# NEVER committed (AGENTS.md: secrets are runtime-only; docs/deployment/
# secrets.md is the secrets registry — the compose path maps its K8s Secret
# rows to named env vars instead). The file is the compose-path equivalent of
# the `zivon-*` K8s Secrets: same variable names, same key meanings.
#
# docker-compose.prod.yml derives ZIVON_DB_URL and ZIVON_LOG_DSN from the
# POSTGRES_* values below — do NOT set them here.
#
# Validate before boot (dummy values must satisfy every REQUIRED entry):
#   docker compose --env-file .env.prod -f docker-compose.prod.yml config
#
# Generation helper for random secrets (run once per variable):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ============================================================================

# --- deployment posture (non-secret, REQUIRED) ------------------------------
# Public origin of the site edge (what the browser sees). Must match DNS +
# TLS at the edge (Caddy/Cloudflare) — email links and the OAuth redirect
# are built from it.
ZIVON_APP_BASE_URL=__ZIVON_APP_BASE_URL__

# Edge proxy (compose profile "edge" / docker/caddy/Caddyfile). Leave empty
# if you front the host with Cloudflare Tunnel or a host-level reverse proxy
# instead; REQUIRED when you run --profile edge.
ZIVON_DOMAIN=
ZIVON_ACME_EMAIL=

# --- DATABASE (REQUIRED secret) ---------------------------------------------
# Postgres 16 password (the compose-path equivalent of the `zivon-db-env`
# K8s Secret key POSTGRES_PASSWORD). ZIVON_DB_URL + ZIVON_LOG_DSN are derived
# from these three values — never set those two here. Keep the password
# URL-safe (letters/digits, e.g. the token_hex helper below): it is
# interpolated verbatim into those DSNs, so characters like @ : / would
# break DSN parsing (boot refuses loudly, but avoid the confusion).
POSTGRES_DB=zivon
POSTGRES_USER=zivon
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

# --- SESSION + ABUSE COUNTERS (REQUIRED secrets) ----------------------------
# The `zivon-voice-env` Secret keys, one-to-one. Boot REFUSES to start the
# backend without them when ZIVON_ENV=prod (backend/config.py).
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ZIVON_SESSION_TOKEN_KEY=__GENERATE_TOKEN_HEX_32__
ZIVON_IP_HASH_SALT=__GENERATE_TOKEN_HEX_32__

# Single-admin bearer for /v1/admin/* (ADR-0026; the `zivon-admin-auth`
# Secret key). Empty = admin routes answer 503. Recommended: set it.
ZIVON_ADMIN_TOKEN=__GENERATE_LONG_RANDOM_TOKEN__

# --- GOOGLE OAUTH (ADR-0029; optional until Google sign-in is enabled) ------
# Google Cloud OAuth client (type: Web application). The redirect URI must
# be <ZIVON_APP_BASE_URL>/auth/google/callback (the F2 callback route).
# The client secret is a SECRET; the client id is config.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=__GOOGLE_CLIENT_SECRET__
GOOGLE_REDIRECT_URI=

# --- EMAIL (REQUIRED in prod — the dev mail sink is refused) ----------------
# backend/auth/email.py refuses ZIVON_EMAIL_BACKEND=dev when ZIVON_ENV=prod:
# verification/reset mail must have a real transport. Pick ONE backend:
#   smtp   -> fill ZIVON_SMTP_* (STARTTLS is on by default)
#   resend -> fill ZIVON_RESEND_API_KEY
ZIVON_EMAIL_BACKEND=__smtp_or_resend__
ZIVON_EMAIL_FROM=Zivon <no-reply@__YOUR_DOMAIN__>
ZIVON_SMTP_HOST=
ZIVON_SMTP_PORT=587
ZIVON_SMTP_USER=__SMTP_USER__
ZIVON_SMTP_PASSWORD=__SMTP_PASSWORD__
ZIVON_SMTP_STARTTLS=true
ZIVON_RESEND_API_KEY=__RESEND_API_KEY__

# --- GEMINI TUTOR (voice tutor brain; runtime-only secret) ------------------
# The `zivon-voice-env` Secret key ZIVON_VOICE_GEMINI_API_KEY (ADR-0017,
# Gate A: Gemma 4 26B A4B via the Gemini API). Empty = the voice path
# degrades honestly (text path, no mic); the rest of the product still works.
ZIVON_VOICE_GEMINI_API_KEY=__GEMINI_API_KEY__

# Voice vendor keys (the `zivon-voice-env` Secret rows; api.vachana.ai).
# Empty = STT/TTS degrade honestly; the voice loop needs both for a live turn.
GNANI_PRISMA_API_KEY=__GNANI_PRISMA_KEY__
GNANI_TIMBRE_API_KEY=__GNANI_TIMBRE_KEY__

# OpenRouter fallback transport for the tutor brain (optional; ADR-0017).
ZIVON_OPENROUTER_API_KEY=
ZIVON_VOICE_BRAIN_FALLBACK_API_KEY=

# --- PERSONALIZED LEARNING ROUTE (D-PL-07 / ADR-0030; OpenCode DeepSeek) ----
# The `zivon-personalized-env` route, separate from BOTH the voice tutor and
# the factory (its own secret; never point it at another route's key).
# The turn engine stays OFF until BOTH values exist — enabling the engine
# without a complete route makes boot REFUSE (loud, §7.3). OFF = the teach
# route answers 503 E-PL-MODEL-DOWN honestly.
ZIVON_PERSONALIZED_TURN_ENGINE_ENABLED=false
ZIVON_PERSONALIZED_BASE_URL=__OPENCODE_OPENAI_BASE_URL__
ZIVON_PERSONALIZED_API_KEY=__OPENCODE_API_KEY__
ZIVON_PERSONALIZED_MODEL=deepseek-v4.1-flash

# --- VOICE CONFIG (non-secret knobs; defaults mirror k8s/28) ----------------
# Leave the defaults unless the founder records a deviation. The recorded
# demo deviation (docs/specs/voice-agent/open-questions.md OQ-04) is:
#   ZIVON_VOICE_BRAIN_MODEL=gemini-2.5-flash  +  ZIVON_VOICE_BRAIN_THINKING_BUDGET=0
# ZIVON_VOICE_BRAIN_MODEL=gemma-4-26b-a4b-it
# ZIVON_VOICE_BRAIN_THINKING_BUDGET=0
# ZIVON_VOICE_STT_URL=wss://api.vachana.ai/stt/v3/stream
# ZIVON_VOICE_TTS_URL=wss://api.vachana.ai/api/v1/tts
# ZIVON_VOICE_PROFILE=demo
# ZIVON_VOICE_CREDIT_DAILY_TRANCHE=1000
# ZIVON_VOICE_CREDIT_PER_USER_CAP=30

# --- PERSONALIZED QUOTAS (non-secret; D-PL-01 defaults) ---------------------
# ZIVON_PERSONALIZED_TURNS_PER_USER_DAY=40
# ZIVON_PERSONALIZED_SESSIONS_PER_USER_DAY=5
# ZIVON_PERSONALIZED_ARTIFACTS_PER_USER_DAY=12
# ZIVON_PERSONALIZED_TURNS_GLOBAL_DAY=1500
# ZIVON_PERSONALIZED_ARTIFACTS_GLOBAL_DAY=300

# --- misc (defaults are right for the prototype) ----------------------------
# ZIVON_LOG_LEVEL=INFO
# ZIVON_BACKEND_RELEASE=0.1.0

# ============================================================================
# FORBIDDEN in this file (the backend or the docs refuse them in prod):
#   ZIVON_ENV=dev            -> docker-compose.prod.yml hard-sets prod.
#                               NEVER override: dev would fall back to a
#                               sqlite in-memory DB and boot without secrets.
#   ZIVON_EMAIL_BACKEND=dev  -> refused by backend/auth/email.py in prod.
#   ZIVON_SPEAKING_MOCK=1    -> refused when ZIVON_ENV is cluster/prod.
#   POSTGRES_HOST_AUTH_METHOD=trust -> passwordless Postgres; dev-only.
#   Real key material anywhere in git — rotate immediately if one leaks
#   (docs/deployment/secrets.md rotation runbook).
# ============================================================================
